	// For format details, see https://aka.ms/devcontainer.json. For config options, see the
	{
		"name": "Demiurge (CUDA, OCaml, Ollama, llvm and uv + Python 3.13)",
		"build": {
			"dockerfile": "Dockerfile",
			"context": "." 
		},
		"features": {
			"ghcr.io/devcontainers/features/common-utils:2": {
				"installZsh": "false",
				"username": "vscode",
				"userUid": "1000",
				"userGid": "1000",
				"upgradePackages": "true"
			},
			"ghcr.io/devcontainers/features/git:1": {},
			"ghcr.io/devcontainers/features/git-lfs:1": {},
			"ghcr.io/devcontainers/features/github-cli:1": {},
			"ghcr.io/devcontainers-extra/features/vscode-cli:1": {},
			"ghcr.io/devcontainers-extra/features/vscode-server:1": {},
			"ghcr.io/eitsupi/devcontainer-features/nushell:0": {},
			"ghcr.io/devcontainers-extra/features/pre-commit:2": {},
			"ghcr.io/stuartleeks/dev-container-features/shell-history:0": {},
			"ghcr.io/prulloac/devcontainer-features/ollama:1": {},
			"ghcr.io/devcontainers/features/python:1": {
				"version": "3.13"
			},
			"ghcr.io/va-h/devcontainers-features/uv:1": {},
			"ghcr.io/devcontainers-extra/features/mypy:2": {},
			"ghcr.io/devcontainers-extra/features/ruff:1": {},
			"ghcr.io/devcontainers-extra/features/pylint:2": {},
			"ghcr.io/devcontainers-extra/features/nox:2": {},
			"ghcr.io/schlich/devcontainer-features/helix:1": {},
			"ghcr.io/warrenbuckley/codespace-features/sqlite:1": {},
			"ghcr.io/devcontainers-extra/features/xonsh:1": {}
		},
		"customizations": {
			"vscode": {
				"settings": {
					"terminal.integrated.defaultProfile.linux": "nu",
					"python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python",
					"python.linting.enabled": true,
					"python.linting.ruffEnabled": true,
					"editor.formatOnSave": true,
					"[python]": {
						"editor.defaultFormatter": "charliermarsh.ruff",
						"editor.codeActionsOnSave": {
							"source.fixAll": "explicit"
						}
					},
					"ocaml.sandbox": {
						"kind": "opam",
						"switch": "5.3.0"
					}
				},
				"extensions": [
					"ms-python.python",
					"charliermarsh.ruff",
					"matangover.mypy",
					"perras.UV",
					"ms-python.vscode-pylance",
					"ocamllabs.ocaml-platform",
					// "ms-python.debugpy",
					// "ms-toolsai.jupyter",
					"eamodio.gitlens"
				]
			}
		},
		// --- Lifecycle Commands ---
		"postCreateCommand": "bash .devcontainer/setup.sh",
		// --- Host and Networking ---
		"hostRequirements": {
			"gpu": "optional"
		},
		"runArgs": ["--network=host"], // Using host network, so forwardPorts is not needed
		"mounts": [
			"source=demiurge-ollama-models,target=/home/vscode/.ollama,type=volume",
			"source=opam-cache,target=/home/vscode/.opam,type=volume"
		],
		"remoteUser": "vscode",
		"remoteEnv": {
			// Make Ollama accessible outside the container
			"OLLAMA_HOST": "0.0.0.0"
			// OR (GPU/Docker (not codespace)):
			// "OLLAMA_SERVER": "http://host.docker.internal:11434"
			// if using jupyter instead of vscode for notebooks:
			// "postStartCommand": "source .venv/bin/activate && jupyter-lab --ip=0.0.0.0 --no-browser --allow-root"
		}
}
